{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/web/node_modules/@estiva-app/ui/dist/gates/cli.js\" hook --app web"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run ui:find *)",
      "Bash(npm --prefix * run ui:find *)",
      "PowerShell(npm run ui:find *)",
      "PowerShell(npm --prefix * run ui:find *)"
    ]
  }
}
