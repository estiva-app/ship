{
  "name": "estiva-ship",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A minimal issue tracker on Nostr — projects, issues, comments",
  "scripts": {
    "dev": "vite --port 5191 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "tsx scripts/app.test.ts && tsx scripts/manifest-slots.test.ts && tsx scripts/issue-description.test.ts && tsx scripts/manifest-actions.test.ts &&tsx scripts/references.test.ts && tsx scripts/attachments.test.ts && tsx scripts/reload-folders.test.ts && tsx scripts/move-project.test.ts && tsx scripts/folder-create-rename.test.ts && tsx scripts/conformance.test.ts && tsx scripts/publish-manifest.test.ts",
    "test:app": "tsx scripts/app.test.ts",
    "smoke": "npm run build && tsx scripts/smoke.ts",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "lint:rules": "eslint --config eslint.gates.config.js .",
    "postlint:rules": "estiva-gates count --repo ship",
    "gates:status": "estiva-gates status",
    "ui:find": "estiva-ui find --repo ship",
    "registry": "estiva-ui build --repo ship",
    "registry:check": "estiva-ui check --repo ship",
    "probe": "tsx scripts/probe-kinds.ts",
    "verify": "tsx scripts/verify.ts",
    "manifest": "tsx scripts/publish-manifest.ts",
    "seed:peek": "tsx scripts/seed-for-peek.ts"
  },
  "dependencies": {
    "@estiva-app/conversation": "^0.2.0",
    "@estiva-app/identity": "^0.2.2",
    "@estiva-app/interop": "^0.44.0",
    "@estiva-app/platform": "^0.4.0",
    "@estiva-app/protocol": "^0.26.1",
    "@estiva-app/ui": "^0.52.0",
    "@tabler/icons-react": "^3.41.1",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@noble/curves": "1.9.2",
    "@noble/hashes": "1.8.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.11"
  }
}
