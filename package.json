{
  "name": "estiva-ship",
  "private": true,
  "type": "module",
  "description": "A minimal issue tracker on Nostr \u2014 projects, issues, comments",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs && node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe-kinds.ts",
    "probe:agent": "tsx scripts/probe-agent.ts",
    "probe:manifest": "tsx scripts/manifest-reader.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "extension": "node scripts/build-extension.mjs",
    "extension:pack": "node scripts/build-extension.mjs --pack",
    "agent": "tsx scripts/agent.ts",
    "test:signer:agent": "tsx scripts/agent-signer.test.ts",
    "soak:renewal": "tsx scripts/agent-renewal-soak.ts",
    "verify": "tsx scripts/verify.ts",
    "manifest": "tsx scripts/publish-manifest.ts",
    "test": "tsx scripts/nip19.test.ts && tsx scripts/app.test.ts && tsx scripts/signer.test.ts && tsx scripts/directory.test.ts && tsx scripts/auth-shell.test.ts && tsx scripts/agent-cli.test.ts && tsx scripts/mcp-server.test.ts && tsx scripts/extension.test.ts && tsx scripts/manifest-reader.test.ts",
    "test:directory": "tsx scripts/directory.test.ts",
    "test:nip19": "tsx scripts/nip19.test.ts",
    "test:app": "tsx scripts/app.test.ts",
    "test:signer": "tsx scripts/signer.test.ts",
    "smoke": "node build.mjs && tsx scripts/smoke.ts",
    "seed:peek": "tsx scripts/seed-for-peek.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "1.9.2",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.61.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
